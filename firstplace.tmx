    <property name="image" value="'cloakedcreator.png'"/>
    <property name="sprite" value="sprite"/>
   </properties>
  </tile>
  <tile id="1">
   <properties>
    <property name="description" value="'There was a Fredrick before you.     He... became undeserving of the title of Hero.'"/>
   </properties>
  </tile>
  <tile id="2">
   <properties>
    <property name="description" value="'One day, he stumbled upon knowledge. Knowledge better left unknown...'"/>
   </properties>
  </tile>
  <tile id="3">
   <properties>
    <property name="description" value="'He became irregular. A Maverick, if  you will. He had to be stopped,      before he did something drastic.'"/>
   </properties>
  </tile>
  <tile id="4">
   <properties>
    <property name="description" value="'So, I removed him. He was taken and placed somewhere where he could do no harm.'"/>
   </properties>
  </tile>
  <tile id="5">
   <properties>
    <property name="description" value="'However, he escaped. It cost him his identity, however, as you are        Fredrick, now. Not him.'"/>
   </properties>
  </tile>
  <tile id="6">
   <properties>
    <property name="description" value="'He has chosen you as the scapegoat for his failures, and is determined to destroy you, and the world along with it. In one big, suicidal cosmic temper tantrum.'"/>
   </properties>
  </tile>
  <tile id="7">
   <properties>
    <property name="description" value="'So now, you have a choice. Do you want to sit around, enjoy your last few peaceful days here, or begin a journey to stop the original Fredrick?'"/>
   </properties>
  </tile>
  <tile id="8">
   <properties>
    <property name="description" value="&quot;You don't really have a choice, as this would be a disappointing and somewhat depressing video game should you choose to do nothing.'"/>
   </properties>
  </tile>
